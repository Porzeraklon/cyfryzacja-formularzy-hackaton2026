# === COI Form Digitizer - konfiguracja WYŁĄCZNIE runtime (nigdy w docker build) ===

# Tryb pracy: development | test | production
# development aktywuje POST /api/v1/auth/dev-token
ENV=development

# Przetwarzanie plików (FR-05..FR-09)
MAX_FILE_SIZE_BYTES=20971520
MAX_BATCH_FILES=20

# JWT (FR-09). W produkcji JWT_AUTH_ENABLED=true i silny sekret!
JWT_AUTH_ENABLED=false
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Pipeline: true = realistyczny mock (core), false = realny pipeline Brancha 1
USE_MOCK_PIPELINE=true

# Ścieżki lokalnych modeli AI/OCR i bazy słowników COI (wolumeny w docker-compose)
MODELS_DIR=models
DICTIONARIES_DIR=data/dictionaries

# Backend LLM: local = llama.cpp + wagi GGUF w MODELS_DIR (offline),
#              api = endpoint OpenAI-compatible (duży model postawiony w urzędzie).
# W trybie api /health raportuje llm=ready, gdy ustawione są LLM_API_URL i LLM_MODEL
# — to sprawdzenie konfiguracji, nie osiągalności (healthcheck nie odpytuje endpointu).
# Błąd endpointu (timeout, 5xx, zły JSON) = twarde 503, bez fallbacku na local.
LLM_BACKEND=local
# LLM_API_URL=http://llm-host:8000/v1
# LLM_API_KEY=sekret-tylko-w-runtime
# LLM_MODEL=qwen2.5-72b-instruct
# LLM_TIMEOUT_SECONDS=600
# json_schema (vLLM, llama.cpp server) | json_object (najszersza zgodność) | none
# LLM_RESPONSE_FORMAT=json_object

# CORS - lista originów rozdzielona przecinkami (frontend serwowany z tego samego hosta)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
